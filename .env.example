# Neon Postgres — Neon Console -> Project -> Connect
DATABASE_URL=your_neon_pooled_connection_string
DATABASE_URL_UNPOOLED=your_neon_direct_connection_string

# Neon Auth — Neon Console -> Branch -> Auth -> Configuration
NEON_AUTH_BASE_URL=your_neon_auth_base_url
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=at_least_32_characters_long

# AI providers
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional model overrides (defaults live in the itinerary route)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
